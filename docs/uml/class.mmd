classDiagram
    direction TB

    namespace model {
        class Aset {
            <<abstract>>
            -String kode
            -String nama
            -StatusAset status
            -Kondisi kondisi
            +bisaDipinjam() boolean
            +getJenis() JenisAset
            +hitungDenda(int hari) long*
        }

        class Ruang {
            -int kapasitas
            +hitungDenda(int hari) long
        }

        class Laptop {
            -String spesifikasi
            -String nomorInventaris
            +hitungDenda(int hari) long
        }

        class AlatLab {
            -String laboratorium
            -TingkatRisiko tingkatRisiko
            +hitungDenda(int hari) long
        }

        class Peminjam {
            <<record>>
            -String id
            -String nama
        }

        class Peminjaman {
            -String id
            -LocalDateTime mulai
            -LocalDateTime selesai
            -StatusPeminjaman status
            +getAset() Aset
            +getPeminjam() Peminjam
        }
    }

    namespace kontrak {
        class DapatDipinjam {
            <<interface>>
            +bisaDipinjam() boolean
        }

        class AturanDenda {
            <<interface>>
            +hitung(Aset aset, int hari) long
        }
    }

    namespace denda {
        class DendaFlat {
            +hitung(Aset aset, int hari) long
        }

        class DendaProgresif {
            +hitung(Aset aset, int hari) long
        }
    }

    namespace jadwal {
        class JadwalPeminjaman {
            -List~Peminjaman~ daftar
            +tambah(Peminjaman p) void
            +bentrok(Peminjaman baru) boolean
        }
    }

    DapatDipinjam <|.. Aset : implements
    Aset <|-- Ruang : extends
    Aset <|-- Laptop : extends
    Aset <|-- AlatLab : extends

    AturanDenda <|.. DendaFlat : implements
    AturanDenda <|.. DendaProgresif : implements
    DendaFlat ..> Aset : menghitung
    DendaProgresif ..> Aset : menghitung

    Peminjaman "0..*" --> "1" Aset : memakai
    Peminjaman "0..*" --> "1" Peminjam : diajukan oleh
    JadwalPeminjaman "1" --> "0..*" Peminjaman : menyimpan

    note for JadwalPeminjaman "bentrok() masih TODO minggu 7"
